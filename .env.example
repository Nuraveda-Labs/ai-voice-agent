# Database
DATABASE_URL=postgresql://user:pass@host:5432/voice_agent

# LiveKit
LIVEKIT_URL=wss://your-livekit-server.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SIP / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRUNK_DOMAIN=
SIP_OUTBOUND_TRUNK_ID=

# LLM provider (one of)
OPENAI_API_KEY=
SARVAM_API_KEY=
BOLNA_API_KEY=
RETELL_API_KEY=

# Shopify (if using the order-confirm flow)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=

# Webhook receiver
HTTP_PORT=8081
